\li{[整环](00CY)}
\li{[域](00D0)}
\li{[素理想](00CV)}
\li{[极大理想](00CW)}
\li{[局部环](00CX)}
\li{[分式域](00CZ)}
\li{[Noether 环](00D1)}
\li{[Krull 维数](00D2)}
}
