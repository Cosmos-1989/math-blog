\title{外微分满足平方为零}
\date{2026-04-14}
\taxon{Lemma}
\author{author}

\p{外微分满足重要恒等式}

##{d\circ d=0.}

\p{证明只需在局部检查形如}

##{\omega(x)=f(x)dx^{i_1}\wedge\cdots\wedge dx^{i_p}}

\p{的 #{p}-形式，再由线性性扩张到一般形式。由 [外微分](004C) 的定义，}

##{d(d\omega)
=\frac{\partial^2 f}{\partial x^j\partial x^k}
dx^k\wedge dx^j\wedge dx^{i_1}\wedge\cdots\wedge dx^{i_p}.}

\p{因为混合偏导对称}

##{\frac{\partial^2 f}{\partial x^j\partial x^k}
=\frac{\partial^2 f}{\partial x^k\partial x^j},}

\p{而外积反对称}

##{dx^k\wedge dx^j=-dx^j\wedge dx^k,}

\p{所以上式为零。}
