\title{几何与物理：微分几何基础}
\date{2026-04-14}
\taxon{Outline}
\author{author}

\p{本页整理《Geometry and Physics》第 1 章 Geometry 中 1.1 Riemannian and Lorentzian Manifolds 的 1.1.1 Differential Geometry 内容。按照 evergreen notes 的原则，长篇教材叙述被拆成可独立阅读的原子页；本页只给出阅读顺序和依赖关系。}

\strong{坐标、向量与张量}

\ol{
  \li{\strong{[微分几何的对象与坐标观点](0041)}：几何对象不依赖坐标，而坐标表示会变换}
  \li{\strong{[Einstein 求和约定与指标升降](0042)}：省略求和号、Kronecker 符号与度量升降指标}
  \li{\strong{[光滑流形的局部坐标](0043)}：流形由坐标图局部表示，坐标变换为微分同胚}
  \li{\strong{[切向量与切空间](0044)}：切向量作为对函数求导的算子}
  \li{\strong{[切向量的坐标变换与推前](0045)}：切向量的反变变换律}
  \li{\strong{[向量场与 Lie 括号](0046)}：向量场、#{C^\infty(M)}-模结构和 Lie 括号公式}
  \li{\strong{[余切向量与拉回](0047)}：余切向量的协变变换律}
  \li{\strong{[张量与度量张量](0048)}：度量张量、向量内积与余向量内积}
}

\strong{外形式与外微分}

\ol{
  \li{\strong{[外形式与外积](0049)}：#{p}-形式作为余切空间外幂中的截面}
  \li{\strong{[Riemann 度量的体积形式与积分](004A)}：有向性、体积形式和 #{L^2} 内积}
  \li{\strong{[四维流形上的自对偶与反自对偶二形式](004B)}：二形式的正交分解}
  \li{\strong{[外微分](004C)}：坐标公式、乘积法则与拉回自然性}
  \li{\strong{[外微分满足平方为零](004D)}：#{d\circ d=0} 的局部证明}
  \li{\strong{[被动坐标变换与主动变分](004E)}：数学家和物理学家的变换视角}
}

\strong{联络、曲率与测地线}

\ol{
  \li{\strong{[仿射联络与协变导数](004F)}：在流形上不变地微分向量场}
  \li{\strong{[Christoffel 符号](004G)}：联络的坐标表示及其非张量变换律}
  \li{\strong{[联络的挠率张量](004H)}：挠率、无挠联络与 Christoffel 符号的对称性}
  \li{\strong{[平行移动与平行向量场](004I)}：沿曲线的协变常值向量场}
  \li{\strong{[曲率张量](004J)}：协变导数不交换所测量的张量}
  \li{\strong{[测地线、指数映射与全测地子流形](004K)}：自平行曲线与指数映射}
  \li{\strong{[Riemann 联络与 Levi-Civita 联络](004L)}：与度量相容的唯一无挠联络}
}

\strong{曲面的内蕴曲率}

\ol{
  \li{\strong{[微分几何：高斯绝妙定理](0056)}：高斯曲率为何只由第一基本形式决定}
  \li{\strong{[第一基本形式](0057)}：曲面内部长度、角度与面积元的局部表达}
  \li{\strong{[第二基本形式与形算子](0058)}：曲面的外在弯曲与高斯曲率外在公式}
  \li{\strong{[Gauss 方程与高斯曲率的内蕴公式](0059)}：#{K=R_{1212}/(EG-F^2)}}
  \li{\strong{[高斯绝妙定理](005A)}：局部等距保持高斯曲率}
  \li{\strong{[平面、圆柱与球面上的高斯曲率](005B)}：三个标准曲面例子}
}

