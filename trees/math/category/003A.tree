\title{代数理论：语法与语义}
\date{2026-04-14}
\taxon{Outline}
\author{author}

\p{这一页是范畴逻辑中\strong{代数理论}主题的叙事入口。按照 evergreen notes 的组织原则，具体定义、例子和构造被拆成较小的原子页；本页只给出阅读顺序和依赖关系。}

\strong{语法侧}

\ol{
  \li{\strong{[代数理论](003C)}：用全定义运算和方程描述结构}
  \li{\strong{[签名与项](003D)}：运算符号、变量和项的归纳生成}
  \li{\strong{[群论的等式公理化](003E)}：把存在量词改写为常元和一元运算}
  \li{\strong{[代数理论的基本例子](003O)}：环、模、带点集合和归纳数据类型}
}

\strong{边界与非例子}

\ol{
  \li{\strong{[偏序集不是直接的代数理论](003F)}：关系公理不等于运算方程}
  \li{\strong{[meet 半格是代数理论](003G)}：用 meet 运算把一类偏序结构等式化}
  \li{\strong{[G-集合是代数理论](003H)}：群作用作为一族一元运算}
}

\strong{语义侧}

\ol{
  \li{\strong{[代数理论的模型](003I)}：在有有限积的范畴中解释运算和方程}
  \li{\strong{[代数理论的模型与内部群](003B)}：模型、内部群和模型范畴的叙事入口}
}

