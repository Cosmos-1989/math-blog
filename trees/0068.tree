\title{分析}
\date{2026-09-24}
\taxon{Outline}
\author{author}

\p{分析以极限为基础，研究函数的变化、逼近与收敛。微分和积分描述局部变化与整体累积，测度论处理大小与几乎处处的性质，泛函分析把函数视为空间中的点。调和分析和算子理论进一步研究振荡、频率与谱，并为微分方程提供方法。}
\strong{研究专题}
\ul{
  \li{[凸几何的对偶性与体积不等式](0R00)：极体、凸函数与序反转变换}
  \li{[稀疏图的局部极限与谱](0S00)：Benjamini–Schramm 收敛、随机覆盖与极端特征值}
  \li{[Oka 原理与全纯映射的柔性](0T00)：Stein 源空间、全纯逼近与同伦}
  \li{[多气泡等周问题](0U00)：体积约束、最小界面与稳定性}
  \li{[圆法与逐点遍历定理](0V00)：多项式平均、频率分解与振荡估计}
  \li{[Fourier 极值问题](0W00)：带限函数、点取值与极值整函数}
  \li{[Schur 乘子与非交换调和分析](0X00)：矩阵乘子、局部几何与群的刚性}
  \li{[多项式数列的密度界](0GO0)：高阶 Fourier 分析、定量拼接与降阶}
  \li{[von Neumann 代数的边界](0Z00)：核逼近、边界作用与算子代数刚性}
  \li{[Banach 空间的渐近结构](1000)：有限余维博弈、弱零树与嵌入}
  \li{[球面平均与极大函数](1100)：半径集合、维数与局部光滑性}
  \li{[受限正交投影](1200)：分形维数、关联估计与多尺度分解}
  \li{[大双曲曲面的谱隙](0GS0)：变分原理、随机曲面与四分之一阈值}
  \li{[稀薄玻色气体的基态能量](0Q00)：散射长度与 Lee–Huang–Yang 公式}
  \li{[平移铺砌的结构与非周期性](007C)：离散结构与分析方法}
  \li{[驯服几何、积分与有理点](007A)：积分、准备定理与计数}
}
\strong{其他专题}
\ul{
  \li{[von Neumann 双交换子定理](004U)：算子代数与算子拓扑}
  \li{[对偶对、弱拓扑与连续对偶](0039)}
  \li{[局部凸空间与半范数](0038)}
  \li{[内积几何与诱导范数](004T)}
}
