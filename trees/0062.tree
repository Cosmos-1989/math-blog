\title{代数}
\date{2026-09-24}
\taxon{Outline}
\author{author}

\p{从表示、对称性、同调与几何不变量出发，选择感兴趣的研究专题。}

\strong{研究专题}
\ul{
  \li{\strong{[约化代数群的倾斜模：特征标与支持簇](0181)}：最高权、p 典范基与上同调支持}
  \li{\strong{[尖点 Hopf 代数与张量范畴](0140)}：Nichols 代数、玻色化与余循环变形}
  \li{\strong{[高秩算术群的共轭宽度](0160)}：正规生成、同余子群与词宽度}
  \li{\strong{[无空间的交上同调](01C0)}：偏序、拟阵、矩图与 Soergel 双模}
  \li{\strong{[模性提升启发的交换代数](01A0)}：自由性、导出作用与 Wiles 数值判据}
  \li{\strong{[有限群的特征标对应](016Y)}：Clifford 理论、局部对应与 McKay 问题}
  \li{\strong{[全正 Toeplitz 矩阵：经典与现代](01C2)}：参数化、量子 Schubert 多项式与极限}
  \li{\strong{[表示论中的几何模型](0182)}：Gentle 代数、曲面、导出范畴与变形}
  \li{\strong{[寡轨群与张量范畴](014Z)}：轨道、测度、Fraïssé 构造与范畴}
  \li{\strong{[各向同性约化群的初等子群](01E0)}：非稳定 K₁、局部整体原理与挠子}
  \li{\strong{[三维 flop 与收缩代数](01A2)}：非交换不变量、导出商与奇点}
  \li{\strong{[平移铺砌：结构与非周期性](007C)}：阿贝尔群上的周期性与不可判定性}
}

\strong{其他专题}
\ul{
  \li{\strong{[范畴逻辑与代数理论](003A)}：等式理论、模型与内部对象}
  \li{\strong{[模型论群、尖锐传递与 Burnside 问题](007E)}：有限 Morley 秩与几何群论}
  \li{\strong{[NIP 域、赋值与整环](007D)}：可定义性与赋值分类}
}

\p{[专题之间的联系](013Z)}
