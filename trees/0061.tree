\title{逻辑}
\date{2026-09-24}
\taxon{Outline}
\author{author}

\p{从公理、模型、可定义性与复杂度出发，选择感兴趣的研究专题。}

\strong{研究专题}
\ul{
  \li{\strong{[强迫公理与连续统](0077)}：公理选择与集合宇宙}
  \li{\strong{[连续逻辑与度量结构](0078)}：连续取值的语义与模型}
  \li{\strong{[局部问题的组合与算法复杂度](0079)}：可定义解与分布式计算}
  \li{\strong{[驯服几何、积分与有理点](007A)}：准备定理与计数}
  \li{\strong{[遍历系统的分类复杂度](007B)}：描述集合论与动力系统}
  \li{\strong{[平移铺砌的结构与非周期性](007C)}：刚性、编码与不可判定性}
  \li{\strong{[NIP 域、赋值与整环](007D)}：有限组合复杂度的代数后果}
  \li{\strong{[模型论群、尖锐传递与 Burnside 问题](007E)}：有限秩与几何群论}
}

\strong{其他专题}
\ul{
  \li{\strong{[范畴逻辑](003A)}：代数理论的语法与语义}
  \li{\strong{[量子逻辑](0006)}：正交模格与量子命题}
}

