\title{Deroin：Structural Stability in Moduli Spaces of Foliations on Complex Algebraic Surfaces}
\date{2026-10-19}
\taxon{Reference}
\author{author}

\p{Bertrand Deroin，\em{Structural Stability in Moduli Spaces of Foliations on Complex Algebraic Surfaces}，载 \em{Proceedings of the International Congress of Mathematicians 2026, Volume 5: Invited Lectures (Sections 9–11)}，SIAM，2026，100–115 页；在线发表日期 2026-07-13。[正式全文](https://epubs.siam.org/doi/full/10.1137/25M1807186)，[DOI](https://doi.org/10.1137/25M1807186)。}
