          "scope": "围绕候选论证的可靠接受、翻译、局部求解、库复用、教学与交流组织；25原子均直接可达；保留2025-09观点时间基准。"
        },
        "4W01": {
          "status": "definition",
          "scope": "有限词元表、下一词元分布与采样/贪心生成区分；不讲网络训练。"
        },
        "4W02": {
          "status": "local-proof",
          "scope": "条件成功率乘积的逐步证明；零概率前缀单列；相互独立只是充分条件；0.99^1000单位换算。"
        },
        "4W03": {
          "status": "local-counterexamples",
          "scope": "100个事件边际均0.99，交概率分别0.99与0；与独立模型比较，区分风险/经验风险/条件错误率。"
        },
        "4W04": {
          "status": "definition-with-source-qualified-trust",
          "scope": "检查接受蕴含形式判断的约定；形式系统的可靠性和语义翻译另列；sorryAx及公理依赖按官方说明。"
        },
        "4W05": {
          "status": "definition-and-local-rule",
          "scope": "语境、待填证明项和目标；通过函数抽象解除临时假设，复用依赖积规则。"
        },
        "4W06": {
          "status": "local-proof",
          "scope": "有限有向无环依赖局部定义；反向追溯证明有无前置节点，逐次取出排序，再代入局部推导；共同语境保留。"
        },
        "4W07": {
          "status": "definition",
          "scope": "实数倒数补零与除法全函数化；补值与极点处解析性质分开。"
        },
        "4W08": {
          "status": "local-proof",
          "scope": "任意实数分配律；(a /_0 b)b=a当且仅当b非零或a=0；必要性取b=0。"
        },
        "4W09": {
          "status": "local-counterexample",
          "scope": "N=0使所译存在命题空洞成立；N=0,n=1否定无条件倒数单调。"
        },
        "4W0A": {
          "status": "local-proof",
          "scope": "从实数上确界完备性证明自然数无上界，再选择正自然数N>max(1,1/epsilon)。"
        },
        "4W0B": {
          "status": "local-proof",
          "scope": "a0任意，n>=1时an=1/n；由正阈值及差式证明epsilon-N收敛。"
        },
        "4W0C": {
          "status": "local-example-proof",
          "scope": "答案集存在的同义反复；整数n²=1候选{-1,1}的双向证明及漏解反例。"
        },
        "4W0D": {
          "status": "local-proof-from-explicit-limit",
          "scope": "假定(z-a)f(z)->r非零，以eta和|r|/(2M)给出严格模长下界；一阶极点留数局部解释。"
        },
        "4W0E": {
          "status": "cited-analytic-input-and-local-corollary",
          "scope": "zeta定义复用欧拉乘积页；(s-1)zeta(s)->1引用报告；下界由4W0D自证。AlphaProof成功与实际Mathlib补值非零仅按作者报告/其所引Loeffler-Stoll归属。"
        },
        "4W0F": {
          "status": "author-proposed-construction",
          "scope": "四角色方案、人工介入、失败分类；骨架未闭合与证明接受区分。"
        },
        "4W0G": {
          "status": "source-example-with-canonical-reuse",
          "scope": "sqrt2的分解粒度与查库；复用既有无有理根例子和互素定义，不另造重复无理性定理。"
        },
        "4W0H": {
          "status": "local-example-and-library-design-discussion",
          "scope": "正阈值应用与epsilon=min(1/4,eta/2)满足两个参数范围的直接证明；Mathlib兼容性按作者讨论。"
        },
        "4W0I": {
          "status": "author-proposed-metric",
          "scope": "形式化因子的总时间定义；de Bruijn长度比区别；测量范围与学习效应；采用阈值为作者设想。"
        },
        "4W0J": {
          "status": "conditional-local-proof",
          "scope": "固定建库A、每项a和b、无维护成本的假设下计算F_n及n>A/(b-a)；a>=b时不能靠摊销跨阈值。"
        },
        "4W0K": {
          "status": "conditional-local-proof",
          "scope": "同一工作量单位、固定指数增长假设下覆盖比和追平时间；追平后模型需要调整。"
        },
        "4W0L": {
          "status": "local-example-proof",
          "scope": "常数列epsilon-N证明分解为语境/目标；N=0为何可用，与倒数正阈值比较。"
        },
        "4W0M": {
          "status": "attributed-pedagogical-proposal",
          "scope": "具体极限定义与通用抽象的课程选择；Verbose及Real Analysis Game为原章教学实践，不作为效果试验。"
        },
        "4W0N": {
          "status": "attributed-expository-construction",
          "scope": "多层次说明连接想法、依赖和形式声明；以正阈值/倒数为本地实例；blueprint按报告介绍。"
        },
        "4W0O": {
          "status": "attributed-viewpoint-comparison",
          "scope": "Szegedy的长期纠错看法与Kontorovich的当前语义责任分开；零阈值具体说明使用暴露错配。"
        },
        "4W0P": {
          "status": "source-reported-anecdote-and-evidence-distinction",
          "scope": "代码、实际执行与核验分层；亏格轶事按作者转述，不写作本批实验。"
        },
